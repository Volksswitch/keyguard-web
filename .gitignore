node_modules/
output/
outputs/
test-results/
progress.log
*.log

# Generated documents. The .md is the source; the .docx is rebuilt by
# "build the security document" and is never byte-identical twice (a .docx is a
# zip, so it embeds timestamps) - tracking it churned the repo on every build.
# The file still lives on disk and syncs via OneDrive. The PDF made from it by
# "sync docs" is an output too, for the same reason.
SECURITY.docx
SECURITY.pdf

# Manual figures: screenshots regenerated from the running app by
# scripts/doc-generators/capture-manual-figures.mjs, so they are outputs, not sources.
scripts/doc-generators/figures/
__pycache__/

# The published documents' Word and PDF files, and their backups. Ken edits the Word
# files, and the generators in scripts/doc-generators/ are kept in step with them, so a
# lost copy is regenerated from those (Ken, 30 Oct 2026). The sample projects and
# pictures beside them ARE tracked: the videos and the manual's figures are made from them.
Documents/*.docx
Documents/*.pdf
Documents/Doc Backups/

# How-to videos and their speech cache: rendered by scripts/video/render-video.mjs.
# Outputs, published to volksswitch.org, never served from here.
Videos/
